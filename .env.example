# GenesisAI environment. Copy to .env and fill in. NEVER commit .env.
# ---- Runtime ----
ENV=local                      # local | staging | production
LOG_LEVEL=INFO                 # Python log level

# ---- Postgres (Supabase in prod) ----
POSTGRES_USER=genesis          # compose superuser
POSTGRES_PASSWORD=genesis      # compose password (change outside local)
POSTGRES_DB=genesis            # database name
DATABASE_URL=postgresql://genesis:genesis@localhost:5432/genesis  # app connection string

# ---- Redis (queue, cache, rate limits) ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB (vector context memory) ----
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---- Auth (Phase 1) ----
JWT_SECRET=change-me           # HS256 signing secret for access/refresh tokens
JWT_ACCESS_TTL=900             # access token lifetime, seconds (short)
JWT_REFRESH_TTL=1209600        # refresh token lifetime, seconds (14 days)

# ---- Encryption (Phase 1, FR-14) ----
# 32-byte base64 key for AES-GCM encryption of stored provider API keys.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GENESIS_ENCRYPTION_KEY=

# ---- Provider API keys (BYO; used by the router, Phase 2). Leave blank if unused. ----
OPENAI_API_KEY=
XAI_API_KEY=                   # Grok
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434  # local inference; no key needed

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000  # browser -> API base URL
